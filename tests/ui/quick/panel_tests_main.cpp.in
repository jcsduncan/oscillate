// Generated by apps/daw_quick/CMakeLists.txt: runs one device-panel test,
// named by the first argument, from the merged panel test program.
#include <cstring>
#include <iostream>

@oscillate_quick_panel_declarations@
namespace {

struct PanelTest {
  const char* name;
  int (*run)(int, char**);
};

constexpr PanelTest panel_tests[] = {
@oscillate_quick_panel_entries@};

} // namespace

int main(int argc, char** argv) {
  if (argc >= 2) {
    for (const auto& test : panel_tests) {
      if (std::strcmp(argv[1], test.name) == 0)
        return test.run(argc - 1, argv + 1);
    }
  }
  std::cerr << "Usage: oscillate_quick_panel_tests <panel> [arguments]\n";
  return 2;
}
